{
  "name": "agent-policy-map",
  "version": "0.1.1",
  "description": "Compare which coding-agent instructions apply to one file across Codex, Claude Code, Cursor, and Copilot.",
  "keywords": [
    "agents",
    "codex",
    "codex-cli",
    "claude-code",
    "cursor",
    "copilot",
    "github-copilot",
    "agent-policy",
    "cli",
    "AGENTS.md",
    "instructions",
    "precedence"
  ],
  "author": "Ashish Kaloge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashishkaloge/agent-policy-map.git"
  },
  "homepage": "https://github.com/ashishkaloge/agent-policy-map#readme",
  "bugs": {
    "url": "https://github.com/ashishkaloge/agent-policy-map/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-policy-map": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "node dist/cli.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test && npm run smoke",
    "prepack": "npm run build"
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/picomatch": "^3.0.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^4.1.11"
  }
}
